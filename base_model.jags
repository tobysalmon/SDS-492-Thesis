
model {
  # Likelihood - mixed distributions
  # NA values will be automatically predicted by JAGS
  for(i in 1:tmax) {
    flu[i]   ~ dnegbin(p1[i], r[1])   # Negative Binomial
    rsv[i]   ~ dpois(lambda2[i])       # Poisson
    covid[i] ~ dnegbin(p3[i], r[3])   # Negative Binomial
    ili[i]   ~ dnegbin(p4[i], r[4])   # Negative Binomial

    # Reparameterize NegBin: p = r/(r+lambda) so mean = lambda, var = lambda + lambda^2/r
    p1[i] <- r[1] / (r[1] + lambda1[i])
    p3[i] <- r[3] / (r[3] + lambda3[i])
    p4[i] <- r[4] / (r[4] + lambda4[i])

    lambda1[i] <- exp(phi[i,1])
    lambda2[i] <- exp(phi[i,2])
    lambda3[i] <- exp(phi[i,3])
    # ILI offset: phi[i,4] is the log rate per patient tested;
    # multiply by num_patients to get the expected count
    lambda4[i] <- exp(phi[i,4]) * num_patients[i]
  }

  # Priors - Seasonal AR(1) process for each disease
  for(k in 1:4) {
    mu0[k] ~ dnorm(0, 1e-4)
    beta_sin[k] ~ dnorm(0, 1e-4)
    beta_cos[k] ~ dnorm(0, 1e-4)
    prec.phi[k] ~ dgamma(0.01, 0.01)
    rho1[k] ~ dunif(0, 1)

    # Seasonal mean at time 1
    mu_t[1,k] <- mu0[k] + beta_sin[k] * sin52[1] + beta_cos[k] * cos52[1]

    # First time point - stationary distribution
    phi[1,k] ~ dnorm(mu_t[1,k], prec.phi[k] * (1 - pow(rho1[k], 2)))

    # AR(1) with seasonal mean for subsequent time points
    for(i in 2:tmax) {
      mu_t[i,k] <- mu0[k] + beta_sin[k] * sin52[i] + beta_cos[k] * cos52[i]
      phi[i,k] ~ dnorm(mu_t[i,k] + rho1[k] * (phi[i-1,k] - mu_t[i-1,k]),
                        prec.phi[k])
    }
  }

  # Overdispersion priors for NegBin diseases only (flu, covid, ili)
  # RSV uses Poisson so does not have an r parameter
  r[1] ~ dgamma(0.1, 0.1)   # Flu
  r[3] ~ dgamma(0.1, 0.1)   # COVID
  r[4] ~ dgamma(0.1, 0.1)   # ILI
}

